FoamFile {
  version     4.0;
  format      ascii;
  class       dictionary;
  location    "constant/porousMat";
  object      porousMatProperties;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

/****************************** GENERAL ************************************/
//debug yes;
movingMesh      no;
/****************************** end GENERAL ********************************/

/****************************** IO *****************************************/
IO {
  writeFields (); // write fields in the time folders
  // probingFunctions
  // (
  //     plotDict
  // ); // name of sampling/probing dictionaries in "system/porousMat"
}
/****************************** END IO ************************************/

/****************************** MASS, ENERGY, PYROLYSIS *******************/
MaterialProperties {
  MaterialPropertiesType Fourier; // porous material properties
  //MaterialPropertiesDirectory "$PATO_DIR/data/Materials/Fourier/FourierTemplate"; // material properties file
  MaterialPropertiesDirectory "constant/";
}

Pyrolysis {
  PyrolysisType no; // PATO pyrolysis
}

Mass {
  MassType ReadPressure; // Provide/read pressure field required by HeatFlux BC
}

Energy {
  EnergyType PureConduction; // Solve the temperature equation
}
/****************************** END MASS, ENERGY, PYROLYSIS ****************/

